<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhomemoPaint</AssemblyName>
    <RootNamespace>PhomemoPaint</RootNamespace>
    <Version>0.2.0</Version>
    <Authors>XWolfOverride</Authors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- WinForms no admite Native AOT: un unico .exe que depende del runtime de .NET instalado,
         con Phomemo.Printing.dll dentro. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phomemo.Printing\Phomemo.Printing.csproj" />
    <ProjectReference Include="..\Phomemo.Printing.Windows\Phomemo.Printing.Windows.csproj" />
  </ItemGroup>

</Project>
