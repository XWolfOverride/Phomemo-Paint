<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Phomemo.Printing.Windows</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>XWolfOverride</Authors>

    <!-- Transportes que necesitan APIs de Windows (Bluetooth LE via WinRT). Se mantiene aparte
         para que Phomemo.Printing siga siendo portable. Tambien respeta las limitaciones de AOT. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phomemo.Printing\Phomemo.Printing.csproj" />
  </ItemGroup>

</Project>
